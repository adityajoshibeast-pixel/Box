MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB=menu_app
ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret

# File storage
BLOB_READ_WRITE_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Update emails — Zoho Mail. With MFA enabled, generate an App Password in
# Zoho Accounts > Security; never use your normal Zoho password here.
ZOHO_EMAIL=your-address@zohomail.com
ZOHO_APP_PASSWORD=your-generated-app-password
ZOHO_FROM=Resource Navigator <your-address@zohomail.com>
# Confirm this in Zoho Mail > Settings > Mail Accounts > Server Configuration.
ZOHO_SMTP_HOST=smtp.zoho.com

# Optional Resend fallback (only useful with a verified sending domain)
RESEND_API_KEY=re_your_api_key
UPDATE_EMAIL_FROM=Resource Navigator <updates@your-verified-domain.com>

# Owner alerts whenever a PDF or image is downloaded. Multiple addresses can
# be comma-separated. If blank, ZOHO_EMAIL is used as the recipient.
DOWNLOAD_NOTIFICATION_EMAIL=owner@example.com

# Optional: Vercel automatically sends this as a Bearer token to cron routes.
CRON_SECRET=replace-with-a-long-random-secret

# Optional on Vercel; otherwise its production URL is detected automatically.
PUBLIC_APP_URL=https://your-project.vercel.app
